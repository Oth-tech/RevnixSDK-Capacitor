{
  "name": "revnix-capacitor",
  "version": "1.11.0",
  "description": "Revnix SDK for Capacitor: in-app purchases through StoreKit 2 and Google Play Billing, entitlements, paywalls, A/B tests and attribution over the Revnix /v1 API.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/revnix-kotlin/revnix-core/src/main/",
    "android/revnix-kotlin/revnix-android/src/main/",
    "android/build.gradle",
    "dist/",
    "docs/",
    "ios/Sources",
    "ios/Tests",
    "ios/Revnix/Package.swift",
    "ios/Revnix/Sources",
    "ios/Revnix/Tests",
    "Package.swift",
    "RevnixCapacitor.podspec"
  ],
  "author": "Revnix <support@revnix.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oth-tech/RevnixSDK-Capacitor.git"
  },
  "homepage": "https://www.revnix.io/docs/capacitor",
  "bugs": {
    "url": "https://github.com/Oth-tech/RevnixSDK-Capacitor/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native",
    "revnix",
    "in-app-purchase",
    "subscriptions",
    "paywall",
    "entitlements",
    "storekit",
    "play-billing",
    "attribution"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "xcodebuild -scheme RevnixCapacitor -destination generic/platform=iOS",
    "verify:ios:test": "xcodebuild test -scheme RevnixCapacitor -destination 'platform=iOS Simulator,name=iPhone 17 Pro'",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- --fix --format",
    "eslint": "eslint . --ext ts",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api RevnixPlugin --output-readme docs/API.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@ionic/eslint-config": "^0.4.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "eslintConfig": {
    "extends": "@ionic/eslint-config/recommended"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "dependencies": {
    "react-native-revnix": "^1.11.0"
  }
}
